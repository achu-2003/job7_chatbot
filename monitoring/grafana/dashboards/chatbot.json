{
  "title": "E-com CRM Chatbot",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "type": "stat",
      "title": "Requests / min",
      "targets": [{ "expr": "sum(rate(chatbot_http_requests_total[1m])) * 60" }]
    },
    {
      "type": "timeseries",
      "title": "P95 end-to-end latency (s)",
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le) (rate(chatbot_http_request_latency_seconds_bucket[5m])))"
      }]
    },
    {
      "type": "timeseries",
      "title": "SQL latency P95",
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, op) (rate(chatbot_sql_latency_seconds_bucket[5m])))"
      }]
    },
    {
      "type": "timeseries",
      "title": "Vector latency P95",
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le, collection) (rate(chatbot_vector_latency_seconds_bucket[5m])))"
      }]
    },
    {
      "type": "timeseries",
      "title": "LLM tokens / min",
      "targets": [{ "expr": "sum by (model, kind) (rate(chatbot_llm_tokens_total[1m])) * 60" }]
    },
    {
      "type": "stat",
      "title": "Hallucination rate (last 1h)",
      "targets": [{
        "expr": "sum(rate(chatbot_validation_total{result!=\"VALID\"}[1h])) / sum(rate(chatbot_validation_total[1h]))"
      }]
    },
    {
      "type": "timeseries",
      "title": "Intents per minute",
      "targets": [{ "expr": "sum by (intent) (rate(chatbot_intent_total[1m])) * 60" }]
    },
    {
      "type": "timeseries",
      "title": "Errors / min by layer",
      "targets": [{ "expr": "sum by (layer) (rate(chatbot_errors_total[1m])) * 60" }]
    }
  ]
}
